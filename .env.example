# ── Database (Supabase Postgres) ────────────────────────────────────────
# DATABASE_URL: the pooled "Transaction" connection string from
#   Supabase Dashboard -> Project Settings -> Database -> Connection string
#   (port 6543). Used by the app at runtime. Must keep ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: the "Direct connection" string (port 5432) from the same page.
# Used only by `prisma migrate` (pgbouncer doesn't support migrations).
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# Separate connection used only by the test suite (concurrency/integration
# tests truncate tables between runs — never point this at your real Supabase
# project; create a second free Supabase project for testing, or keep using
# local Postgres here).
TEST_DATABASE_URL="postgresql://campusguard:campusguard@localhost:5432/campusguard_test?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-64-char-random-hex-string"
JWT_EXPIRES_IN="12h"

# ── QR / Security session signing ────────────────────────────────────────
# Secret used to HMAC-sign QR payloads. Generate with: openssl rand -hex 32
QR_SECRET="replace-with-a-different-64-char-random-hex-string"
# Default QR/security-session lifetime, in seconds (10-60 recommended).
QR_TTL_SECONDS=20

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV=development

# ── Optional: Supabase (only if you choose the Supabase-backed variant) ──
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# ── Optional: Redis (only needed if you swap the in-memory rate limiter) ─
# REDIS_URL="redis://localhost:6379"
