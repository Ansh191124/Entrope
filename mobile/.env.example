# The CampusGuard backend's base URL.
#
# IMPORTANT: if you're testing on a physical phone via Expo Go, "localhost"
# means the PHONE, not your computer — it will not reach your dev server.
# Use your computer's LAN IP address instead (same Wi-Fi network as the
# phone). Find it with:
#   Windows:      ipconfig            (look for "IPv4 Address")
#   macOS/Linux:  ifconfig | grep inet
#
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
